{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thestorynexus",
  "version": "1.2.11",
  "identifier": "com.thestorynexus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "thestorynexus",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4OTQ2NUQ4NDAwOTVFNzAKUldSd1hnbEEyR1dVbURYK2pkcFZ3UzJMdHZ0YUQrSVIxTHdmcFBvSEVkUWtjNENsa0NpTlBILy8K",
      "endpoints": [
        "https://github.com/vijayk1989/TheStoryNexusTauriApp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
